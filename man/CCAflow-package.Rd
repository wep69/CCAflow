\name{CCAflow-package}
\alias{CCAflow-package}
\alias{CCAflow}
\title{CCAflow: integrated canonical correlation and multiview association workflows}
\description{CCAflow unifies classical, regularized, sparse, resistant, rank/copula, kernel, probabilistic, Bayesian, deep, functional, temporal and multiblock canonical association workflows. The package deliberately separates in-sample fit, inference, resampling stability and out-of-sample generalization.}
\details{Core methods use dependency-light numerical routines. Optional engines are called only when installed and are never installed automatically. Publication output uses optional graphics and document packages.}
\seealso{\code{cca_fit}, \code{cca_validate}, \code{cca_plot}, \code{cca_teach}}
\docType{package}
